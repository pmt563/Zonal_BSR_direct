# Multi-architecture Dockerfile for AMD64 and ARM64
# Build arguments to determine target architecture
ARG TARGETARCH

# Use an official Python runtime as a parent image
FROM python:3.10-slim

# Set the working directory in the container
WORKDIR /app

# Install dependencies
# Install pip in upgrade mode and kuksa-client globally
RUN pip install --upgrade pip && \
    pip install --no-cache-dir kuksa-client

# Create necessary directory structure
RUN mkdir -p /app/src

# Copy application code (architecture-independent)
COPY src/zonal_app.py /app/src/zonal_app.py
COPY src/can_driver.py /app/src/can_driver.py

# Copy architecture-specific libraries
# Docker BuildKit will automatically set TARGETARCH to amd64 or arm64
ARG TARGETARCH
RUN echo "Building for architecture: ${TARGETARCH}"

# Copy the correct library based on target architecture
COPY src/${TARGETARCH}/libcontrolcanfd.so /app/src/libcontrolcanfd.so
COPY src/${TARGETARCH}/libcontrolcanfd.a /app/src/libcontrolcanfd.a

# Make port 80 available to the world outside this container
EXPOSE 80

# Set the entrypoint and command
ENTRYPOINT ["python", "src/zonal_app.py"]
CMD ["-loopback=0","192.168.1.1:55555"]
